# Public Client ID from https://developer.spotify.com/dashboard
# Do not put a Client Secret here — this app uses PKCE.
VITE_SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on the Spotify app (Add + Save).
# Keep this on 5173. Do not switch to 5174 if the port is busy — stop the other server.
VITE_REDIRECT_URI=http://127.0.0.1:5173/callback
